RewriteEngine On
RewriteBase /catalog/

# Domain migration for catalog subtree: old domain -> new domain
RewriteCond %{HTTP_HOST} ^(www\.)?(шмитрикс\.рф|xn--h1aagfvid9b\.xn--p1ai)$ [NC]
RewriteRule ^(.*)$ https://xn--80adkogkeibavehoi.xn--p1ai/catalog/$1 [R=301,L,QSA]

# Route /catalog/api/* requests to proxy script
RewriteRule ^api/(.*)$ api-proxy.php/api/$1 [QSA,L]

# Keep direct proxy entry executable
RewriteRule ^api-proxy\.php$ - [L]
RewriteRule ^api-proxy\.php/.*$ - [L]

# Existing files and directories should bypass SPA fallback
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback
RewriteRule ^ index.html [L]

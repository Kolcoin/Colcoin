# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-please-to-a-long-random-string
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Bot engine (Playwright robots) ---
# Сколько роботов одновременно работают
WORKER_CONCURRENCY=2
# Headless: 1 — без окна (production), 0 — с окном (отладка)
PLAYWRIGHT_HEADLESS=1
# Базовая задержка между задачами на одном "пользователе" (сек, мин-макс)
TASK_MIN_DELAY=15
TASK_MAX_DELAY=60
# Поисковая система (yandex|google)
SEARCH_ENGINE=yandex
# Регион Яндекса (lr): 213 — Москва, 2 — Санкт-Петербург, 65 — Новосибирск, 0 — без региона
YANDEX_REGION=213
# Сколько страниц выдачи максимум листать в поиске целевого сайта
MAX_SERP_PAGES=10
# Прокси: пусто или list через запятую: http://user:pass@host:port,socks5://...
PROXY_LIST=

# --- Telegram bot (опционально) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ENABLED=0

# --- Demo / тестовый режим ---
# 1 = роботы НЕ ходят на реальные поисковики, а на встроенный mock-сайт (для тестирования и обучения)
DEMO_MODE=1

RewriteEngine On

# Remove noisy q=... query variants in one step to canonical HTTPS URL
RewriteCond %{QUERY_STRING} (^|&)q=[^&]*(&|$) [NC]
RewriteRule ^ https://xn--h1aagfvid9b.xn--p1ai%{REQUEST_URI}? [R=301,L]

# Canonical host + HTTPS
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^xn--h1aagfvid9b\.xn--p1ai$ [NC]
RewriteRule ^ https://xn--h1aagfvid9b.xn--p1ai%{REQUEST_URI} [R=301,L]

# Canonical index URL
RewriteRule ^index\.html$ https://xn--h1aagfvid9b.xn--p1ai/ [R=301,L,NC]

# Normalize trailing slash on html files
RewriteCond %{REQUEST_URI} \.html/$ [NC]
RewriteRule ^(.+)\.html/$ https://xn--h1aagfvid9b.xn--p1ai/$1.html [R=301,L]

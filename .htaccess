RewriteEngine On

# 0) Root query cleanup: /?q=... -> https://host/ (one hop)
RewriteCond %{REQUEST_URI} ^/?$ [NC]
RewriteCond %{QUERY_STRING} (^|&)q=[^&]*(&|$) [NC]
RewriteRule ^$ https://xn--h1aagfvid9b.xn--p1ai/? [R=301,L,NE]

# 1) Remove noisy q=... query variants in one step to canonical HTTPS URL
#    Use THE_REQUEST + QUERY_STRING for non-root paths to avoid rewrite loops.
RewriteCond %{THE_REQUEST} \s/+[^\s?]+\?[^\s]*\bq= [NC]
RewriteCond %{QUERY_STRING} (^|&)q=[^&]*(&|$) [NC]
RewriteRule ^ https://xn--h1aagfvid9b.xn--p1ai%{REQUEST_URI}? [R=301,L,NE]

# 2) Canonical index URL
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]|$) [NC]
RewriteRule ^index\.html$ https://xn--h1aagfvid9b.xn--p1ai/ [R=301,L,NE]

# 3) Canonical host + HTTPS.
#    Respect reverse-proxy HTTPS header to avoid extra hop where possible.
RewriteCond %{HTTP_HOST} !^xn--h1aagfvid9b\.xn--p1ai$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://xn--h1aagfvid9b.xn--p1ai%{REQUEST_URI} [R=301,L,NE]

# 4) Normalize trailing slash on html files
RewriteCond %{REQUEST_URI} \.html/$ [NC]
RewriteRule ^(.+)\.html/$ https://xn--h1aagfvid9b.xn--p1ai/$1.html [R=301,L,NE]

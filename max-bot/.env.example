# Скопируй в .env и впиши свои значения

# Токен MAX-бота. Получить на https://business.max.ru
MAX_BOT_TOKEN=

# MAX-ID админа (твой). Чтобы узнать — напиши боту /id (после первого запуска)
ADMIN_ID=

# MAX-ID курьера. Узнать тем же способом — курьер пишет боту /id
COURIER_ID=

# MAX chat_id группы курьеров, куда падают новые заказы.
# Создай группу в MAX, добавь туда бота, затем напиши в группе /id —
# бот ответит chat_id. Впиши его сюда (может быть отрицательным).
GROUP_ID=

# Ссылка на оплату. Создай платёжную ссылку в ЮKassa / Сбербанк / СБП
# (например, на 150₽ или универсальная) и впиши сюда.
# Сейчас оплата работает по принципу "клиент перешёл по ссылке и оплатил".
PAY_LINK=https://yoomoney.ru/quickpay/example

# Username саппорта в MAX (без @). Кнопка "Поддержка" откроет чат с ним.
SUPPORT_USERNAME=
